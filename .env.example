# Discord application / bot
DISCORD_TOKEN=replace_with_your_bot_token
CLIENT_ID=replace_with_your_discord_application_id

# Dashboard OAuth2 — configure the exact same redirect URI in Discord Developer Portal
DASHBOARD_CLIENT_SECRET=replace_with_your_oauth_client_secret
DASHBOARD_REDIRECT_URI=https://YOUR-DOMAIN/auth/callback

# Use a long random secret. Never commit real secrets.
DASHBOARD_SESSION_SECRET=replace_with_a_long_random_secret
DASHBOARD_ADMIN_IDS=

# Hosting providers usually supply PORT automatically
PORT=3000
NODE_ENV=production
