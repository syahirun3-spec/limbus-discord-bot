# Add real values only to your hosting provider's private environment settings.
DISCORD_TOKEN=replace_with_your_bot_token
CLIENT_ID=replace_with_your_discord_application_id
DASHBOARD_CLIENT_SECRET=replace_with_your_oauth_client_secret
DASHBOARD_REDIRECT_URI=https://YOUR-VERCEL-PROJECT.vercel.app/api/auth/callback
DASHBOARD_SESSION_SECRET=replace_with_a_random_secret_of_32_characters_or_more
DASHBOARD_ADMIN_IDS=
FRONTEND_ORIGIN=https://syahirun3-spec.github.io
FRONTEND_URL=https://syahirun3-spec.github.io/limbus-discord-bot/
NODE_ENV=production
